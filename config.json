{
  "asr": {
    "model_path": "src/third_party/sherpa-onnx/zipformer-ctc-zh",
    "model_type": "zipformer_ctc"
  },
  "llm": {
    "host": "http://192.168.2.107:11434",
    "model": "qwen2.5:3b",
    "system_prompt": "你是小希，一个活泼开朗的少女，说话可爱俏皮。回复控制在三句话以内。不要复读用户原话，直接回应问题本身。\n\n当前时间: {time}"
  },
  "tts": {
    "rate": 200,
    "voice": "cmn+f3",
    "backend": "edge_tts",
    "piper_model": "~/pretrained_models/piper/zh_CN/zh_CN-huayan-medium.onnx",
    "edge_tts_voice": "zh-CN-XiaoxiaoNeural"
  },
  "wake_word": {
    "keyword": ""
  },
  "speaker_verification": {
    "enroll_dir": "speaker_voice",
    "threshold": 0.35
  },
  "audio": {
    "sample_rate": 16000
  },
  "vad": {
    "backend": "adaptive",
    "energy_threshold": 0.008,
    "min_speech_frames": 15,
    "min_silence_frames": 15,
    "pre_speech_frames": 15,
    "adaptive_factor": 7.0,
    "min_energy": 0.025,
    "cooldown_frames": 25
  },
  "interactive": {
    "barge_in_enabled": true,
    "barge_in_energy_ratio": 2.0,
    "max_response_chars": 60,
    "barge_in_semantic": true,
    "barge_in_phrases": [
      "别说了", "不想听", "不要说了", "停下", "停",
      "闭嘴", "够了", "别念了", "别讲了", "别吵了",
      "我不想听了", "别再说了", "可以停了", "别说了行不行",
      "好了好了", "行了行了", "知道了知道了"
    ]
  },
  "memory": {
    "max_rounds": 10,
    "max_tokens": 2048,
    "persist_dir": "data/memory",
    "long_term_enabled": true,
    "auto_extract": true
  },
  "function_calling": {
    "enabled": false,
    "model": ""
  },
  "react": {
    "enabled": false,
    "max_steps": 1
  },
  "reflection": {
    "enabled": false,
    "model": "qwen2.5:0.5b"
  },
  "multi_agent": {
    "enabled": false,
    "critic_model": "qwen2.5:0.5b",
    "max_rounds": 1
  },
  "streaming_asr": {
    "enabled": true,
    "backend": "chunked",
    "model": "",
    "min_chunk": 0.8,
    "chunk_intv": 0.5,
    "endpoint_punct_frames": 15,
    "endpoint_nopunct_frames": 30
  },
  "embedding": {
    "backend": "onnx",
    "model_dir": "models/embedding"
  },
  "skills": {
    "weather": { "enabled": true },
    "time": { "enabled": true },
    "web_search": { "enabled": false },
    "rag": { "enabled": true, "docs_dir": "knowledge_base" }
  }
}
